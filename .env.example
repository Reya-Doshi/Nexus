# ==============================================================================
# ReRoute - Qualcomm AI Inference Suite (Cirrascale) Configuration
# ==============================================================================
# DO NOT commit real keys to version control or paste into chat/frontend.
# Copy this file to .env and insert your personal Cirrascale Qualcomm credentials.

# Cirrascale Qualcomm AI Suite Base API Endpoint
QUALCOMM_AI_ENDPOINT=https://aisuite.cirrascale.com/apis/v2

# Cirrascale Model Name (e.g. meta-llama/Meta-Llama-3-8B-Instruct, mistralai/Mistral-7B-Instruct-v0.2, etc.)
# Check your dashboard at https://aisuite.cirrascale.com/home for the exact active model ID
QUALCOMM_AI_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Your Personal Cirrascale API Key (from developer dashboard)
QUALCOMM_AI_KEY=your_cirrascale_api_key_here
